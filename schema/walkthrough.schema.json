{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mepolabs/walkmethrough/schema/walkthrough.schema.json",
  "title": "Walkmethrough walkthrough file (v1)",
  "type": "object",
  "required": ["version", "title", "steps"],
  "properties": {
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "description": "What the session built." },
    "summary": { "type": "string", "description": "Architecture explanation (Markdown) shown before step 1." },
    "base_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{4,40}$", "description": "Commit the walkthrough was written against." },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "lines": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 1 },
        { "type": "integer", "minimum": 1 }
      ],
      "minItems": 2,
      "maxItems": 2,
      "description": "[start, end], 1-based, inclusive, start <= end."
    },
    "step": {
      "type": "object",
      "required": ["file", "lines", "title", "why"],
      "properties": {
        "file": { "type": "string", "minLength": 1, "description": "Path relative to the repo root." },
        "lines": { "$ref": "#/$defs/lines" },
        "anchor": { "type": "string", "minLength": 1, "description": "The first 1-3 lines of the range, verbatim; used to re-find it after edits." },
        "title": { "type": "string", "minLength": 1, "description": "One-line name of the step." },
        "why": { "type": "string", "minLength": 1, "description": "What the code does and why (Markdown)." }
      }
    }
  }
}
