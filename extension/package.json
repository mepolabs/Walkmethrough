{
  "name": "walkmethrough",
  "displayName": "Walkmethrough",
  "description": "Play back agent-written code walkthroughs step by step and send review comments back to the agent.",
  "version": "0.1.0",
  "publisher": "mepolabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mepolabs/walkmethrough"
  },
  "homepage": "https://github.com/mepolabs/walkmethrough#readme",
  "bugs": {
    "url": "https://github.com/mepolabs/walkmethrough/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "walkthrough",
    "code review",
    "agent",
    "tour",
    "claude",
    "codex",
    "copilot",
    "cursor"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.walkthrough/*.{yaml,yml}"
  ],
  "contributes": {
    "commands": [
      {
        "command": "walkmethrough.open",
        "title": "Open…",
        "category": "Walkthrough",
        "icon": "$(book)"
      },
      {
        "command": "walkmethrough.next",
        "title": "Next Step",
        "category": "Walkthrough",
        "icon": "$(arrow-right)",
        "enablement": "walkmethrough.playing"
      },
      {
        "command": "walkmethrough.back",
        "title": "Previous Step",
        "category": "Walkthrough",
        "icon": "$(arrow-left)",
        "enablement": "walkmethrough.playing"
      },
      {
        "command": "walkmethrough.goto",
        "title": "Go to Step…",
        "category": "Walkthrough",
        "enablement": "walkmethrough.playing"
      },
      {
        "command": "walkmethrough.close",
        "title": "Close",
        "category": "Walkthrough",
        "icon": "$(close)",
        "enablement": "walkmethrough.playing"
      },
      {
        "command": "walkmethrough.commentOnStep",
        "title": "Comment on Step",
        "category": "Walkthrough",
        "icon": "$(comment)",
        "enablement": "walkmethrough.playing"
      },
      {
        "command": "walkmethrough.copyFeedback",
        "title": "Copy Feedback to Chat",
        "category": "Walkthrough",
        "icon": "$(copy)",
        "enablement": "walkmethrough.playing"
      },
      {
        "command": "walkmethrough.comment.create",
        "title": "Add Comment"
      },
      {
        "command": "walkmethrough.comment.cancelDraft",
        "title": "Cancel"
      },
      {
        "command": "walkmethrough.comment.edit",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "walkmethrough.comment.delete",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "walkmethrough.comment.save",
        "title": "Save"
      },
      {
        "command": "walkmethrough.comment.cancelEdit",
        "title": "Cancel"
      },
      {
        "command": "walkmethrough.refreshCoverage",
        "title": "Refresh Coverage",
        "category": "Walkthrough",
        "icon": "$(refresh)",
        "enablement": "walkmethrough.playing"
      }
    ],
    "configuration": {
      "title": "Walkthrough",
      "properties": {
        "walkmethrough.inlineExplanation": {
          "type": "boolean",
          "default": true,
          "description": "Show each step's explanation in the editor, right below the highlighted lines, as well as in the Walkthrough view."
        }
      }
    },
    "keybindings": [
      {
        "command": "walkmethrough.next",
        "key": "alt+]",
        "when": "walkmethrough.playing"
      },
      {
        "command": "walkmethrough.back",
        "key": "alt+[",
        "when": "walkmethrough.playing"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "walkmethrough.panel",
          "name": "Walkthrough"
        },
        {
          "id": "walkmethrough.coverage",
          "name": "Not in Walkthrough",
          "when": "walkmethrough.playing"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "walkmethrough.open",
          "when": "view == walkmethrough.panel",
          "group": "navigation@1"
        },
        {
          "command": "walkmethrough.copyFeedback",
          "when": "view == walkmethrough.panel && walkmethrough.playing",
          "group": "navigation@2"
        },
        {
          "command": "walkmethrough.close",
          "when": "view == walkmethrough.panel && walkmethrough.playing",
          "group": "navigation@3"
        },
        {
          "command": "walkmethrough.refreshCoverage",
          "when": "view == walkmethrough.coverage",
          "group": "navigation"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "walkmethrough.commentOnStep",
          "when": "commentController == walkmethrough && commentThread == walkmethrough.step",
          "group": "inline@0"
        },
        {
          "command": "walkmethrough.back",
          "when": "commentController == walkmethrough && commentThread == walkmethrough.step",
          "group": "inline@1"
        },
        {
          "command": "walkmethrough.next",
          "when": "commentController == walkmethrough && commentThread == walkmethrough.step",
          "group": "inline@2"
        },
        {
          "command": "walkmethrough.close",
          "when": "commentController == walkmethrough && commentThread == walkmethrough.step",
          "group": "inline@3"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "walkmethrough.comment.create",
          "when": "commentController == walkmethrough && commentThreadIsEmpty",
          "group": "inline@1"
        },
        {
          "command": "walkmethrough.comment.cancelDraft",
          "when": "commentController == walkmethrough && commentThreadIsEmpty",
          "group": "inline@2"
        }
      ],
      "comments/comment/title": [
        {
          "command": "walkmethrough.comment.edit",
          "when": "commentController == walkmethrough && comment == walkmethrough.feedback",
          "group": "inline@1"
        },
        {
          "command": "walkmethrough.comment.delete",
          "when": "commentController == walkmethrough && comment == walkmethrough.feedback",
          "group": "inline@2"
        }
      ],
      "comments/comment/context": [
        {
          "command": "walkmethrough.comment.save",
          "when": "commentController == walkmethrough && comment == walkmethrough.feedback",
          "group": "inline@1"
        },
        {
          "command": "walkmethrough.comment.cancelEdit",
          "when": "commentController == walkmethrough && comment == walkmethrough.feedback",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "walkmethrough.comment.create",
          "when": "false"
        },
        {
          "command": "walkmethrough.comment.cancelDraft",
          "when": "false"
        },
        {
          "command": "walkmethrough.comment.edit",
          "when": "false"
        },
        {
          "command": "walkmethrough.comment.delete",
          "when": "false"
        },
        {
          "command": "walkmethrough.comment.save",
          "when": "false"
        },
        {
          "command": "walkmethrough.comment.cancelEdit",
          "when": "false"
        }
      ]
    },
    "colors": [
      {
        "id": "walkmethrough.stepHighlight",
        "description": "Background of the lines covered by the current walkthrough step.",
        "defaults": {
          "dark": "#3a6ea522",
          "light": "#3a6ea518",
          "highContrast": "#3a6ea533"
        }
      },
      {
        "id": "walkmethrough.stepGutter",
        "description": "Gutter bar marking the lines of the current walkthrough step.",
        "defaults": {
          "dark": "#4f8fd6",
          "light": "#2f6db3",
          "highContrast": "#6fb0ff"
        }
      },
      {
        "id": "walkmethrough.uncoveredGutter",
        "description": "Marker on changed lines that no walkthrough step covers.",
        "defaults": {
          "dark": "#d18616",
          "light": "#b5700a",
          "highContrast": "#ffa344"
        }
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          ".walkthrough/*.feedback.yaml",
          ".walkthrough/*.feedback.yml"
        ],
        "url": "./schema/feedback.schema.json"
      },
      {
        "fileMatch": [
          ".walkthrough/*.yaml",
          ".walkthrough/*.yml",
          "!.walkthrough/*.feedback.yaml",
          "!.walkthrough/*.feedback.yml"
        ],
        "url": "./schema/walkthrough.schema.json"
      }
    ]
  },
  "scripts": {
    "build": "npm run copy-assets && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=dist/extension.js --sourcemap",
    "typecheck": "tsc -p . --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \"out-test/test/*.test.js\"",
    "package": "npm run build -- --minify && vsce package --no-dependencies",
    "test:integration": "npm run build && tsc -p tsconfig.test.json && node out-test/test-integration/run.js",
    "copy-assets": "node -e \"const fs=require('fs');fs.cpSync('../schema','schema',{recursive:true});fs.copyFileSync('../LICENSE','LICENSE')\""
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
